# Copy this file to `.env.local` and fill in your Firebase web app config.
# Leave these empty to run in DEMO MODE (data is saved in this browser's localStorage).
# Never commit .env.local to source control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to require Firebase email/password sign-in before using the app.
VITE_FIREBASE_REQUIRE_AUTH=false
