rules_version = '2';
// Starter rules: only signed-in users may read/write shop data.
// Set VITE_FIREBASE_REQUIRE_AUTH=true and create operator accounts in Firebase Authentication.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection in [
        'invoices', 'customers', 'products', 'goldRates', 'silverRates',
        'settings', 'payments', 'auditLogs', 'invoiceNumbers'
      ];
    }

    // Invoice number reservations can be created once and never changed or deleted.
    match /invoiceNumbers/{num} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Audit logs are append-only.
    match /auditLogs/{id} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
  }
}
