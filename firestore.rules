rules_version = '2';

// ABS Jewellery Billing — Firestore security rules.
// Only signed-in shop operators (Firebase Authentication) can read or write.
// Requires VITE_FIREBASE_REQUIRE_AUTH=true in .env.local so the app shows the sign-in screen.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Shop data: customers, products, rates, settings (incl. invoice counter), payments.
    match /{collection}/{docId} {
      allow read, write: if signedIn() && collection in [
        'customers', 'products', 'goldRates', 'silverRates', 'settings', 'payments'
      ];
    }

    // Invoices can be created and revised, but only drafts can ever be deleted.
    match /invoices/{invoiceId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && resource.data.status == 'draft';
    }

    // One reservation per invoice number: created once, never changed or deleted.
    match /invoiceNumbers/{number} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // Audit trail is append-only.
    match /auditLogs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
  }
}
